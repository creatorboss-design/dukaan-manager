rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /invoices/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /{allPaths=**} {
      allow read, write: if false; // deny everything else by default
    }
  }
}
